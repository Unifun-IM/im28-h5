# Gateway 地址必须由部署环境确认，禁止从移动端历史配置隐式继承。
VITE_GATEWAY_HTTP_URL=
VITE_GATEWAY_WS_URL=

# HTTP OpenAPI 路由平台；生产 H5 默认 h5，桌面形态开发可设为 pc。
VITE_GATEWAY_PLATFORM=pc

# OpenIM 官方 Web platform ID；部署环境可显式覆盖。
VITE_IM_PLATFORM_ID=5
VITE_IM_LANGUAGE=zh-CN

# 必须由部署流水线注入真实 Web build identity，禁止回退到 package.json 版本。
VITE_APP_VERSION=
# 可选非负十进制构建号。
VITE_APP_BUILD_NUMBER=
